# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FOOTBALL_DATA_API_KEY: Required for live football scores, standings, fixtures, and top scorers.
# Powered by football-data.org API
FOOTBALL_DATA_API_KEY="3e97d8ffaa504d8ab69a2afd4bec58ce"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# MIDO VIDEO AI - VIDEO GENERATION PROVIDER
# ==========================================
# VIDEO_API_KEY: Secret API key for the video generation provider (e.g. Luma AI, Runway, Replicate, Fal.ai, etc.)
# Never expose this key to the frontend/browser. Set this in your server environment variables or AI Studio Secrets.
VIDEO_API_KEY=

# VIDEO_API_BASE_URL: Base URL for the video generation REST API (optional, defaults to provider standard)
# Example: https://api.lumalabs.ai/dream-machine/v1
VIDEO_API_BASE_URL=

# JSON2VIDEO_API_KEY: Secret API key for JSON2Video API v2 rendering engine
JSON2VIDEO_API_KEY=

# CHATGPT_CONNECTOR_TOKEN: Secret authentication bearer token for ChatGPT Remote Actions & MCP interface
CHATGPT_CONNECTOR_TOKEN="mido_chatgpt_token_999"

